# 复制本文件为 .env（本地调试用），或在 GitHub Secrets 中逐项配置
# 推荐用 DeepSeek：注册 https://platform.deepseek.com 后创建 API Key
LLM_API_KEY=你的_LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 推送渠道（按需填写，没填的自动跳过）=====
# 微信推送（Server酱）：https://sct.ftqq.com 扫码拿 SendKey
SERVERCHAN_SENDKEY=

# 企业微信 / 钉钉 / 飞书 群机器人 Webhook 地址
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=

# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=

# 邮箱推送（QQ/163/Gmail 等，密码处填"授权码"而非登录密码）
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_USE_SSL=true
